# Baseball bat model (simplified box shape)
# Handle: 0.08 x 0.08, y: 0.0 to 0.5
# Barrel: 0.16 x 0.16, y: 0.5 to 1.3
mtllib bat.mtl

# === Normals ===
vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0

# === Handle vertices ===
# Bottom (y=0)
v -0.04  0.00 -0.04
v  0.04  0.00 -0.04
v  0.04  0.00  0.04
v -0.04  0.00  0.04
# Top (y=0.5)
v -0.04  0.50 -0.04
v  0.04  0.50 -0.04
v  0.04  0.50  0.04
v -0.04  0.50  0.04

# === Barrel vertices ===
# Bottom (y=0.5)
v -0.08  0.50 -0.08
v  0.08  0.50 -0.08
v  0.08  0.50  0.08
v -0.08  0.50  0.08
# Top (y=1.3)
v -0.08  1.30 -0.08
v  0.08  1.30 -0.08
v  0.08  1.30  0.08
v -0.08  1.30  0.08

usemtl bat

# === Handle faces ===
# Bottom cap
f 1//5 3//5 2//5
f 1//5 4//5 3//5
# Front (z-)
f 1//1 2//1 6//1
f 1//1 6//1 5//1
# Back (z+)
f 3//2 4//2 8//2
f 3//2 8//2 7//2
# Left (x-)
f 4//3 1//3 5//3
f 4//3 5//3 8//3
# Right (x+)
f 2//4 3//4 7//4
f 2//4 7//4 6//4

# === Transition faces (handle top -> barrel bottom, y=0.5) ===
# Front (z-)
f  5//1  6//1 10//1
f  5//1 10//1  9//1
# Back (z+)
f  7//2  8//2 12//2
f  7//2 12//2 11//2
# Left (x-)
f  8//3  5//3  9//3
f  8//3  9//3 12//3
# Right (x+)
f  6//4  7//4 11//4
f  6//4 11//4 10//4
# Top fill (the flat ring between handle and barrel at y=0.5)
# Front-left
f  5//6  9//6 12//6
f  5//6 12//6  8//6
# Front-right
f  6//6 10//6  9//6
f  6//6  9//6  5//6
# Back-right
f  7//6 11//6 10//6
f  7//6 10//6  6//6
# Back-left
f  8//6 12//6 11//6
f  8//6 11//6  7//6

# === Barrel faces ===
# Front (z-)
f  9//1 10//1 14//1
f  9//1 14//1 13//1
# Back (z+)
f 11//2 12//2 16//2
f 11//2 16//2 15//2
# Left (x-)
f 12//3  9//3 13//3
f 12//3 13//3 16//3
# Right (x+)
f 10//4 11//4 15//4
f 10//4 15//4 14//4
# Top cap
f 13//6 14//6 15//6
f 13//6 15//6 16//6
